{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "schedule.create.mfa",
  "title": "Creates a 24/7 door schedule that holds the door in two-factor",
  "api": "command",
  "host": "api",
  "method": "PUT",
  "path": "organizations/{{org_id}}/schedules",
  "effect": "create",
  "params": {
    "door_id": {},
    "schedule_name": {}
  },
  "request": {
    "body": {
      "sitesEnabled": true,
      "schedules": [
        {
          "doors": ["{{door_id}}"],
          "events": [
            {
              "doorLockState": "ACCESS_CONTROL_2FA",
              "weekday": 1,
              "date": null,
              "startTime": "00:00:00.000",
              "endTime": "23:59:59.999",
              "twoPersonRuleEnabled": false
            },
            {
              "doorLockState": "ACCESS_CONTROL_2FA",
              "weekday": 2,
              "date": null,
              "startTime": "00:00:00.000",
              "endTime": "23:59:59.999",
              "twoPersonRuleEnabled": false
            },
            {
              "doorLockState": "ACCESS_CONTROL_2FA",
              "weekday": 3,
              "date": null,
              "startTime": "00:00:00.000",
              "endTime": "23:59:59.999",
              "twoPersonRuleEnabled": false
            },
            {
              "doorLockState": "ACCESS_CONTROL_2FA",
              "weekday": 4,
              "date": null,
              "startTime": "00:00:00.000",
              "endTime": "23:59:59.999",
              "twoPersonRuleEnabled": false
            },
            {
              "doorLockState": "ACCESS_CONTROL_2FA",
              "weekday": 5,
              "date": null,
              "startTime": "00:00:00.000",
              "endTime": "23:59:59.999",
              "twoPersonRuleEnabled": false
            },
            {
              "doorLockState": "ACCESS_CONTROL_2FA",
              "weekday": 6,
              "date": null,
              "startTime": "00:00:00.000",
              "endTime": "23:59:59.999",
              "twoPersonRuleEnabled": false
            },
            {
              "doorLockState": "ACCESS_CONTROL_2FA",
              "weekday": 7,
              "date": null,
              "startTime": "00:00:00.000",
              "endTime": "23:59:59.999",
              "twoPersonRuleEnabled": false
            }
          ],
          "name": "{{schedule_name}}",
          "type": "DOOR",
          "priority": "SCHEDULE",
          "defaultDoorLockState": "ACCESS_CONTROL"
        }
      ]
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object"
    },
    "example": {}
  },
