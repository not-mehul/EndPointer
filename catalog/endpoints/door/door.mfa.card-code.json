{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "door.mfa.card-code",
  "title": "Require card + PIN code at the door",
  "api": "command",
  "host": "api",
  "method": "POST",
  "path": "door/config/set",
  "effect": "update",
  "params": {
    "door_id": {}
  },
  "request": {
    "body": {
      "doorId": "{{door_id}}",
      "action": "grant",
      "paramName": "mfa-card-code-enabled",
      "paramValue": true
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object",
      "properties": {
        "doorConfigParams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doorId": {
                "type": ["string", "number", "boolean"]
              },
              "paramName": {
                "type": "string"
              },
              "paramValue": {
                "type": "boolean"
              }
            },
            "required": ["doorId", "paramName", "paramValue"]
          }
        }
      },
      "required": ["doorConfigParams"]
    },
    "example": {
      "doorConfigParams": [
        {
          "doorId": "<door_id>",
          "paramName": "mfa-card-code-enabled",
          "paramValue": true
        }
      ]
    }
  },
  "tags": ["door"],
  "notes": "Needs a real device on the org.",
  "source": {
    "from": "vCommander",
    "methods": ["enable_door_mfa_card_code"]
  },
  "updated": "2026-10-23"
}
