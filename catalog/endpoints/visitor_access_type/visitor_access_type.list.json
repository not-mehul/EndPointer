  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object",
      "properties": {
        "visitTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": ["string", "number", "boolean"]
              },
              "organizationId": {
                "type": ["string", "number", "boolean"]
              },
              "visitTypeId": {
                "type": ["string", "number", "boolean"]
              }
            },
            "required": ["name", "organizationId", "visitTypeId"]
          }
        }
      },
      "required": ["visitTypes"]
    },
    "example": {
      "visitTypes": [
        {
          "name": "<visitor_access_type_name>",
          "organizationId": "<org_id>",
          "visitTypeId": "<visitor_access_type_id>"
        }
      ]
    }
  },
  "tags": ["visitor_access_type"],
  "source": {
    "from": "vCommander",
