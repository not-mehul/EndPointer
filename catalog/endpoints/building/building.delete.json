                "type": ["string", "number", "boolean"]
              },
              "buildingId": {
                "type": ["string", "number", "boolean"]
              },
              "floors": {
                "type": "array"
              },
              "name": {
                "type": ["string", "number", "boolean"]
              },
              "organizationId": {
                "type": ["string", "number", "boolean"]
              }
            },
            "required": ["address", "buildingId", "floors", "name", "organizationId"]
          }
        }
      },
      "required": ["buildings"]
    },
    "example": {
      "buildings": [
        {
          "address": "<address>",
          "buildingId": "<building_id>",
          "floors": [],
          "name": "<building_name>",
          "organizationId": "<org_id>"
        }
      ]
    }
  },
  "tags": ["building"],
  "source": {
    "from": "vCommander",
    "methods": ["delete_building"]
