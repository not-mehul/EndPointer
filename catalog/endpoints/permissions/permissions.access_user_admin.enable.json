{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "permissions.access_user_admin.enable",
  "title": "Grant Access Control User Admin",
  "api": "command",
  "host": "vprovision",
  "method": "POST",
  "path": "org/set_user_permissions",
  "effect": "update",
  "request": {
    "body": {
      "organizationId": "{{org_id}}",
      "targetUserId": "{{user_id}}",
      "returnPermissions": false,
      "grant": [
        {
          "entityId": "{{org_id}}",
          "permission": "ACCESS_CONTROL_USER_ADMIN"
        }
      ],
      "revoke": []
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object"
    },
    "example": {}
  },
  "tags": ["permissions"],
  "source": {
    "from": "vCommander",
    "methods": ["enable_access_admin"]
  },
  "updated": "2026-10-23"
}
