{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "command_connector.delete",
  "title": "Delete command connector",
  "api": "command",
  "host": "vprovision",
  "method": "POST",
  "path": "vfortress/decommission",
  "effect": "delete",
  "params": {
