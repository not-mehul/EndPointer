{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "command_connector.list",
  "title": "List command connectors",
  "api": "command",
  "host": "vprovision",
  "method": "POST",
  "path": "vfortress/list_boxes",
  "effect": "read",
  "request": {
    "body": {
      "organizationId": "{{org_id}}"
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": ["string", "number", "boolean"]
          },
          "organizationId": {
            "type": ["string", "number", "boolean"]
          },
          "name": {
            "type": ["string", "number", "boolean"]
          },
          "siteId": {
            "type": ["string", "number", "boolean"]
          },
          "claimedSerialNumber": {
            "type": ["string", "number", "boolean"]
          }
        },
        "required": ["claimedSerialNumber", "deviceId", "name", "organizationId", "siteId"]
      }
    },
    "example": [
      {
        "deviceId": "<command_connector_id>",
        "organizationId": "<org_id>",
        "name": "<command_connector_name>",
        "siteId": "<site_id>",
        "claimedSerialNumber": "<serial_number>"
      }
    ]
  },
  "tags": ["command_connector"],
  "source": {
    "from": "vCommander",
    "methods": ["get_connector"]
  },
  "updated": "2026-10-23"
}
