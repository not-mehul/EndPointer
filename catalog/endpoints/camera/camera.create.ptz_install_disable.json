{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "camera.create.ptz_install_disable",
  "title": "Turn install mode off on cameras",
  "api": "command",
  "host": "vdeviceconfig",
  "method": "POST",
  "path": "user/camera/config/set",
  "effect": "update",
  "params": {
