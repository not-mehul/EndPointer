{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "public.guest_visits.list",
  "title": "List guest visits in a time range",
  "api": "public",
  "method": "GET",
  "path": "guest/v1/visits",
  "effect": "read",
  "params": {
    "end_time": {},
    "site_id": {},
    "start_time": {}
  },
  "request": {
    "query": {
      "site_id": "{{site_id}}",
      "start_time": "{{start_time}}",
      "end_time": "{{end_time}}",
      "page_size": "100"
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object",
      "properties": {
        "visits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guest": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": ["string", "number", "boolean"]
                  },
                  "email": {
                    "type": ["string", "number", "boolean"]
                  }
                },
                "required": ["email", "full_name"]
              }
            },
            "required": ["guest"]
          }
        },
        "next_page_token": {}
      },
      "required": ["next_page_token", "visits"]
    },
    "example": {
      "visits": [
        {
          "guest": {
            "full_name": "<full_name>",
            "email": "<email>"
          }
        }
      ],
      "next_page_token": null
    }
  },
  "tags": ["public", "guest_visits"],
  "source": {
    "from": "vCommander",
    "methods": ["get_guest_visits"]
  },
  "updated": "2026-10-23"
}
