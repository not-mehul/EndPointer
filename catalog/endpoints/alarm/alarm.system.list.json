{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "alarm.system.list",
  "title": "List alarm systems",
  "api": "command",
  "host": "vproconfig",
  "method": "POST",
  "path": "alarm_system/list",
  "effect": "read",
  "request": {
    "body": {
      "orgId": "{{org_id}}"
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object",
      "properties": {
        "alarmSystems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": ["string", "number", "boolean"]
              },
              "organizationId": {
                "type": ["string", "number", "boolean"]
              },
              "siteId": {
                "type": ["string", "number", "boolean"]
              },
              "leaderDeviceId": {
                "type": ["string", "number", "boolean"]
              }
            },
            "required": ["id", "leaderDeviceId", "organizationId", "siteId"]
          }
        }
      },
      "required": ["alarmSystems"]
    },
    "example": {
      "alarmSystems": [
        {
          "id": "<alarm_system_id>",
          "organizationId": "<org_id>",
          "siteId": "<site_id>",
          "leaderDeviceId": "<alarm_panel_id>"
        }
      ]
    }
  },
  "tags": ["alarm"],
  "source": {
    "from": "vCommander",
    "methods": [
      "get_alarm_device",
      "get_alarm_expander_all",
      "get_alarm_keypad_all",
      "get_alarm_panel_all",
      "get_alarm_partition_all",
      "get_alarm_system",
      "get_wired_input_all",
      "get_wired_output_all",
      "get_wireless_contact_sensor_all",
      "get_wireless_panic_button_all",
      "get_wireless_universal_transmitter_all"
    ]
  },
  "updated": "2026-10-23"
}
