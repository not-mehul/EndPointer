{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "alarm.wired_output.delete",
  "title": "Delete alarm wired output",
  "api": "command",
  "host": "vproconfig",
  "method": "POST",
  "path": "device/delete",
  "effect": "delete",
  "params": {
    "device_id": {}
  },
  "request": {
    "body": {
      "deviceId": "{{device_id}}"
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "object",
          "properties": {
            "id": {
              "type": ["string", "number", "boolean"]
            },
            "alarmSystemId": {
              "type": ["string", "number", "boolean"]
            },
            "name": {
              "type": ["string", "number", "boolean"]
            },
            "type": {
              "type": "string"
            },
            "deleted": {
              "type": "boolean"
            },
            "wiredOutputConfig": {
              "type": "object",
              "properties": {
                "hubId": {
                  "type": ["string", "number", "boolean"]
                },
                "pinNum": {
                  "type": "integer"
                }
              },
              "required": ["hubId", "pinNum"]
            }
          },
          "required": ["alarmSystemId", "deleted", "id", "name", "type"]
        }
      },
      "required": ["device"]
    },
    "example": {
      "device": {
        "id": "<wired_output_id>",
        "alarmSystemId": "<alarm_system_id>",
        "name": "<wired_output_name>",
        "type": "WIRED_GENERIC_OUTPUT",
        "deleted": true,
        "wiredOutputConfig": {
          "hubId": "<alarm_panel_name>",
          "pinNum": 0
        }
      }
    }
  },
  "tags": ["alarm"],
  "notes": "Needs a real device on the org. Same request as alarm.wired_input.delete; vCommander reads a different part of the response.",
  "source": {
    "from": "vCommander",
    "methods": ["delete_wired_output"]
  },
  "updated": "2026-10-23"
}
