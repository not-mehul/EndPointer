        "partition": {
          "type": "object",
          "properties": {
            "id": {
              "type": ["string", "number", "boolean"]
            },
            "alarmSystemId": {
              "type": ["string", "number", "boolean"]
            },
            "name": {
              "type": ["string", "number", "boolean"]
            },
            "responseConfigId": {
              "type": ["string", "number", "boolean"]
            }
          },
          "required": ["alarmSystemId", "id", "name", "responseConfigId"]
        }
      },
      "required": ["partition"]
    },
    "example": {
      "partition": {
        "id": "<partition_id>",
        "alarmSystemId": "<alarm_system_id>",
        "name": "<partition_name>",
        "responseConfigId": "<alarm_response_id>"
      }
    }
  },
  "tags": ["alarm"],
  "source": {
    "from": "vCommander",
    "methods": ["create_alarm_partition"]
