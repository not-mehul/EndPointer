{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "alarm.partition.create",
  "title": "Creates a partition on an alarm system",
  "api": "command",
  "host": "vproconfig",
  "method": "POST",
  "path": "partition/create",
  "effect": "create",
  "params": {
