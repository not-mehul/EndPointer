{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "alarm.partition.assign_response",
  "title": "Binds a partition to an alarm response config",
  "api": "command",
  "host": "vproconfig",
  "method": "POST",
  "path": "partition/assign_response_config",
  "effect": "update",
  "params": {
    "partition_id": {},
    "response_config_id": {}
  },
  "request": {
    "body": {
      "partitionId": "{{partition_id}}",
      "responseConfigId": "{{response_config_id}}"
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object",
      "properties": {
        "partition": {
          "type": "object",
          "properties": {
            "id": {
              "type": ["string", "number", "boolean"]
            },
            "alarmSystemId": {
              "type": ["string", "number", "boolean"]
            },
            "name": {
              "type": ["string", "number", "boolean"]
            },
            "responseConfigId": {
              "type": ["string", "number", "boolean"]
            }
          },
          "required": ["alarmSystemId", "id", "name", "responseConfigId"]
        }
      },
      "required": ["partition"]
    },
    "example": {
      "partition": {
        "id": "<partition_id>",
        "alarmSystemId": "<alarm_system_id>",
        "name": "<partition_name>",
        "responseConfigId": "<alarm_response_id>"
      }
    }
  },
  "tags": ["alarm"],
  "source": {
    "from": "vCommander",
    "methods": ["assign_alarm_partition_response"]
  },
  "updated": "2026-10-23"
}
