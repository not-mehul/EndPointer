{
  "$schema": "../../schema/endpoint.schema.json",
  "id": "alarm.wireless_panic_button.create",
  "title": "Attaches a wireless panic button to a partition",
  "api": "command",
  "host": "vproconfig",
  "method": "POST",
  "path": "unassigned_device/bulk_set_up_wireless_panic_button",
  "effect": "create",
  "params": {
    "alarm_system_id": {},
    "device_id": {},
    "name": {},
    "partition_id": {},
    "serial_number": {}
  },
  "request": {
    "body": {
      "alarmSystemId": "{{alarm_system_id}}",
      "devices": [
        {
          "deviceId": "{{device_id}}",
          "alarmSystemId": "{{alarm_system_id}}",
          "serialNumber": "{{serial_number}}",
          "name": "{{name}}",
          "partitionId": "{{partition_id}}",
          "gestureType": "SINGLE_PRESS"
        }
      ]
    }
  },
  "response": {
    "status": ["2xx"],
    "schema": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": ["string", "number", "boolean"]
              },
              "alarmSystemId": {
                "type": ["string", "number", "boolean"]
              },
              "name": {
                "type": ["string", "number", "boolean"]
              },
              "type": {
                "type": "string"
              },
              "partitionId": {
                "type": ["string", "number", "boolean"]
              },
              "verkadaDeviceConfig": {
                "type": "object",
                "properties": {
                  "serialNumber": {
                    "type": ["string", "number", "boolean"]
                  }
                },
                "required": ["serialNumber"]
              }
            },
            "required": [
              "alarmSystemId",
              "id",
              "name",
              "partitionId",
              "type",
              "verkadaDeviceConfig"
            ]
          }
        }
      },
      "required": ["devices"]
    },
    "example": {
      "devices": [
        {
          "id": "<wireless_panic_button_id>",
          "alarmSystemId": "<alarm_system_id>",
          "name": "<wireless_panic_button_name>",
          "type": "WIRELESS_PANIC_BUTTON",
          "partitionId": "<partition_id>",
          "verkadaDeviceConfig": {
            "serialNumber": "<serial_number>"
          }
        }
      ]
    }
  },
  "tags": ["alarm"],
  "notes": "Needs a real device on the org.",
  "source": {
    "from": "vCommander",
    "methods": ["configure_wireless_panic_button"]
  },
  "updated": "2026-10-23"
}
